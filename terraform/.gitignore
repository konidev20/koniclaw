# Local .terraform directory — provider plugins & modules cache (can be 100s of MB)
.terraform/

# .terraform.lock.hcl is intentionally NOT ignored — commit it to pin provider versions

# State files — contain plaintext secrets; NEVER commit these
*.tfstate
*.tfstate.*
*.tfstate.backup

# Crash log files
crash.log
crash.*.log

# Variable files that may contain secrets
*.tfvars
*.tfvars.json

# Override files (local developer overrides, not meant to be shared)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan output — may contain sensitive data
*.tfplan

# CLI config with potential credentials
.terraformrc
terraform.rc
